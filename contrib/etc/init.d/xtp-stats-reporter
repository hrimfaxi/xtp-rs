#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

SCRIPT="/usr/libexec/xtp-rs/stats_reporter.sh"

start_service() {
    [ -x "$SCRIPT" ] || {
        logger -t xtp-stats-reporter "ERROR: script is not executable: $SCRIPT"
        return 1
    }

    procd_open_instance "main"

    procd_set_param command /bin/sh "$SCRIPT"

    # 给 stats_reporter.sh 的 TERM trap 留出清理 FIFO 和 logread 子进程的时间。
    procd_set_param term_timeout 5

    # debug 日志写到 /tmp/shadowquic-stats-report.debug.log，不经过 stdout/stderr。
    procd_set_param stdout 0
    procd_set_param stderr 0

    # 如Debug=1: 写入 /tmp/shadowquic-stats-report.debug.log
    # 注意：env 是 table，必须一次给全。分多次调用会生成重复的 "env" 键，
    # 后一次会覆盖前一次，导致先前的变量静默丢失。
    procd_set_param env DEBUG=0 REFRESH_INTERVAL=30

    # 运行不足 3600 秒即退出时，按崩溃处理；
    # 5 秒后重启；retry=0 表示无限重试（logd 重启等场景不应放弃）。
    procd_set_param respawn 3600 5 0

    procd_close_instance
}
