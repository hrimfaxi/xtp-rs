#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
STARTUP_DELAY=10

XTP_DIR="/usr/libexec/xtp-rs"
XTP_SETUP="$XTP_DIR/setup-xtp-rs.sh"
XTP_UNSETUP="$XTP_DIR/unsetup-xtp-rs.sh"

start_service() {
  # 1. 先启动主进程（procd 管理）
  procd_open_instance

  if [ -x /sbin/ujail ] && [ -e /etc/capabilities/xtp-rs.json ]; then
    procd_add_jail xtp-rs ronly requirejail
    procd_set_param capabilities /etc/capabilities/xtp-rs.json
    procd_set_param user nobody
    procd_set_param group nobody
    procd_set_param no_new_privs 1
    procd_add_jail_mount /etc/xtp-rs
    procd_add_jail_mount /etc/tsubamegaeshi-rs
    procd_add_jail_mount /usr/local/xray
    procd_add_jail_mount_rw /tmp
  fi

  procd_set_param env xtp-rs_LOCATION_ASSET="/usr/local/xtp-rs"
  procd_set_param limits nofile="1024768 1024768"
  procd_set_param command /usr/bin/xtp-rs -c /etc/xtp-rs/config.toml
  procd_set_param respawn 3600 5 0 # 设置自动重启
  procd_set_param stdout 1 # 启用日志输出
  procd_set_param stderr 1
  procd_close_instance

  # sleep 0.5s
  read -t 0.5 -n 1 2> /dev/null

  # 3. 添加透明代理规则
  if [ -x "$XTP_SETUP" ]; then
    "$XTP_SETUP" || {
      logger -t "xtp-rs" "ERROR: $XTP_SETUP failed"
      return 1
    }
  else
    logger -t "xtp-rs" "ERROR: $XTP_SETUP not found or not executable"
    return 1
  fi
}

stop_service() {
  # 1. 先删除透明代理规则
  if [ -x "$XTP_UNSETUP" ]; then
    "$XTP_UNSETUP" || logger -t "xtp-rs" "WARNING: $XTP_UNSETUP failed"
  else
    logger -t "xtp-rs" "WARNING: $XTP_UNSETUP not found or not executable"
  fi

  # 2. 停止主进程
  service_stop /usr/bin/xtp-rs
}

# vim: set sw=2 ts=2 et:
