config xtp_rs 'main'
	# 中国大陆 IPv4 直连：开启后发往国内 IP 的流量不经过 TPROXY，
	# 保持正常转发路径（fw4 flowtable 软/硬 offload 得以生效）。
	# UCI 路径（注意包名是文件名 xtp-rs，带连字符）：
	#   uci get xtp-rs.main.bypass_chnroute
	# 前置条件：先用 /usr/libexec/xtp-rs/update-chnroute.sh 生成列表
	# 文件 /etc/xtp-rs/chnroute.nft（建议加入 cron 定期刷新）。
	# 改动后需重启服务或重跑 setup-xtp-rs.sh 才会生效。
	option bypass_chnroute '0'

	# 待代理的 TCP 目的端口列表（空白、逗号或分号分隔，1-65535）。
	# UCI 路径：uci get xtp-rs.main.tcp_ports
	# 未安装 uci 的系统可用环境变量 XTP_TCP_PORTS 覆盖；
	# 两者均未设置时使用内置默认值。非法项忽略并告警，
	# 全部无效时回退默认值。改动后需重启服务生效。
	option tcp_ports '80 443'

	# 待代理的 UDP 目的端口列表（格式同上）。
	# 默认 DNS(53) 与 HTTP/3(443) 走代理，其余内网 UDP 直连；
	# 从列表移除某端口后，该端口在内网也将改为直连。
	# UCI 路径：uci get xtp-rs.main.udp_ports
	# 无 uci 系统可用环境变量 XTP_UDP_PORTS 覆盖。
	option udp_ports '53 443'

	# 额外保留 IP / 强制直连地址列表：追加进 nftables reserved_ip 集合，
	# 这些目的地址不经过透明代理（如上游 VPN IP、内网服务器、指定公网 IP）。
	# UCI 路径：uci get xtp-rs.main.ext_reserved_ip
	# 格式：空白、逗号或分号分隔的 IPv4 地址或 CIDR 网段，
	# 如 '10.8.0.1 192.168.9.0/24'；也可用 list 语法逐条定义，
	# uci get 会以空格连接各条目，脚本处理方式相同。
	# 无 uci 的系统可用环境变量 XTP_EXT_RESERVED_IP 覆盖。
	# 非法项忽略并告警；默认为空。改动后需重启服务或重跑 setup-xtp-rs.sh
	# 才会生效。
	option ext_reserved_ip ''

	# 源 IP 直连列表：这些源地址（如内网管理段 10.2.1.0/24）发出的流量
	# 在 prerouting（转发流量）与 output（本机出站流量）中提前 return，
	# 不经过 TPROXY，保持正常转发路径。
	# UCI 路径：uci get xtp-rs.main.bypass_saddr
	# 格式与 ext_reserved_ip 相同：空白、逗号或分号分隔的 IPv4 地址或
	# CIDR 网段，如 '10.2.1.0/24 192.168.9.0/24'；也可用 list 语法逐条
	# 定义，uci get 会以空格连接各条目，脚本处理方式相同。
	# 无 uci 的系统可用环境变量 XTP_BYPASS_SADDR 覆盖。
	# 非法项忽略并告警；默认为空。改动后需重启服务或重跑 setup-xtp-rs.sh
	# 才会生效。
	option bypass_saddr ''

	# 按进程属主（uid）跳过代理：output 链中属主为该用户/uid 的本机出站
	# 流量提前 return，不进入 TPROXY。防环路的替代方案——让 xtp-rs 以
	# 专用用户运行并设置本选项，即使出站 socket 未设置 fwmark 也不会
	# 自环。取值为用户名（如 'xtp-rs'）或数字 uid；用户名在应用规则时
	# 解析为数字 uid，用户不存在则告警并忽略。
	# UCI 路径：uci get xtp-rs.main.bypass_skuid
	# 无 uci 的系统可用环境变量 XTP_BYPASS_SKUID 覆盖。
	# 注意：uid 0（root）会放行所有 root 进程的本机出站流量，效果上
	# 等于关闭本机出站代理，填 0 时脚本会额外告警；一般只应填专用
	# 低权用户。数字写法的前导零会被归一化（'007' -> 7）。
	# 默认为空（关闭）。改动后需重启服务或重跑 setup-xtp-rs.sh 才会生效。
	option bypass_skuid ''

